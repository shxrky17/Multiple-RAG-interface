    "def print_sections(sections, level=0):\n",
    "    for s in sections:\n",
    "        print(\"%s: %s - %s\" % (\"*\" * (level + 1), s.title, s.text[0:40]))\n",
    "        print_sections(s.sections, level + 1)"
